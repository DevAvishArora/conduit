# ────────────────────────────────────────────────────────────────
# Flow — environment configuration
# Copy to .env and adjust. NEVER commit a real .env.
# ────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# ── HTTP ────────────────────────────────────────────────────────
API_PORT=8080
# Public base URL used to build webhook ingress URLs returned to clients
PUBLIC_BASE_URL=http://localhost:8080

# ── Postgres ────────────────────────────────────────────────────
# The application connects as a NON-superuser so RLS is enforced
# (superusers and table owners bypass RLS by default).
DATABASE_URL=postgres://flow_app:flow_app_pw@localhost:5432/flow
# Used only by the migrate runner / admin tasks (table owner).
DATABASE_ADMIN_URL=postgres://flow:flow@localhost:5432/flow
PG_POOL_MAX=10

# ── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ── Auth (asymmetric JWT — see ADR-007) ─────────────────────────
# Generate with: pnpm keygen
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
JWT_ALG=RS256
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000

# ── Secrets envelope encryption ─────────────────────────────────
# Root KEK used to wrap per-tenant DEKs. 32 bytes, base64.
# Generate with: openssl rand -base64 32
# In production this lives in KMS, not an env var.
SECRETS_ROOT_KEK=Zmxvdy1kZXYtb25seS1yb290LWtlay0zMi1ieXRlcyE=

# ── Webhook ingress ─────────────────────────────────────────────
WEBHOOK_REPLAY_WINDOW_SECONDS=300
WEBHOOK_NONCE_TTL_SECONDS=300

# ── Execution engine ────────────────────────────────────────────
WORKER_CONCURRENCY=10
WORKER_LEASE_MS=60000
NODE_DEFAULT_TIMEOUT_MS=30000
RUN_MAX_NODES=1000
RETRY_BASE_MS=1000
RETRY_MAX_MS=60000

# ── Scheduler ───────────────────────────────────────────────────
SCHEDULER_LEASE_TTL_MS=30000
SCHEDULER_RENEW_INTERVAL_MS=10000

# ── SSRF / egress hardening ─────────────────────────────────────
# Comma-separated. Empty => default block of private ranges only.
EGRESS_BLOCK_PRIVATE_IPS=true
EGRESS_ALLOWLIST=

# ── Google OAuth (optional) ─────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must EXACTLY match GOOGLE_REDIRECT_URI below.
# When unset, the "Continue with Google" button returns a friendly 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/v1/auth/oauth/google/callback

# ── Web frontend origin ─────────────────────────────────────────
# Where the React app is served. The API redirects here after OAuth with
# tokens in the URL fragment. In production this is typically the same
# origin as the API behind a reverse proxy.
WEB_BASE_URL=http://localhost:5173
